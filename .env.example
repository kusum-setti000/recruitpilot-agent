# Copy to .env and fill in ONE key. With no key the agent runs offline (deterministic mode).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# auto | anthropic | openai | mock   (auto picks whichever key is set)
LLM_PROVIDER=auto
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-4o-mini
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2

# Sources: comma separated names from agent/sources/__init__.py
EXTERNAL_SOURCES=json_external
INTERNAL_DB=data/internal_past_hires.json
EXTERNAL_DB=data/external_talent_pool.json

# Recruiter policy
SHORTLIST_SIZE=10
WARM_BENCH_GUARANTEED=true
AVAILABLE_SOON_DAYS=60
MIN_INTERNAL_RATING=3.5
SEND_NAMES_TO_LLM=false

# Pin "today" for reproducible demos (contract end dates are compared against it)
AGENT_TODAY=2026-11-11
